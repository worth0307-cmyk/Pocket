# ============ Telegram（可选，仅用于 /list /balance /history 等查询命令）============
# 已取消消息推送功能：机器人不再主动发提醒，新成交只在网页面板上显示红圈未读数。
# 只用网页面板的话，把下方 BOT_ENABLED 设为 false，这两项可留空。
# 找 @BotFather 创建机器人拿到 token
TELEGRAM_BOT_TOKEN=
# 默认聊天 ID（找 @userinfobot 获取你的数字 ID）
TELEGRAM_CHAT_ID=
# 允许控制机器人的 Chat ID 列表，逗号分隔；留空=默认用 TELEGRAM_CHAT_ID（仅你本人可用）
ALLOWED_CHAT_IDS=
# Telegram 代理（国内必填，api.telegram.org 被墙）。支持 http/socks5，例如：
#   http://127.0.0.1:7890   或   socks5://127.0.0.1:1080
# 留空=直连（仅在能直接访问 Telegram 的网络下可用）。
TELEGRAM_PROXY=

# ============ 数据源 API Key（免费，按需填）============
# EVM 链（ETH/BSC/Base/Arb/Polygon/OP）跟踪需要：https://etherscan.io/myapikey
# 一个 key 通吃所有 EVM 链（Etherscan V2）。不填则这些链不可用。
ETHERSCAN_API_KEY=
# Solana 动作解析需要：https://dashboard.helius.dev （免费档）
# 不填则 Solana 只能查余额、无法自动跟踪买卖。
HELIUS_API_KEY=
# 完整代币持仓 + USD 估值 + 多链聚合 + 垃圾币过滤（类 DeBank）需要：
# https://admin.moralis.com → 注册 → 复制 API Key（免费档 40k CU/天）
# 不填则 EVM 仅显示原生币余额（其余功能不受影响）。
MORALIS_API_KEY=
# 比特币使用 mempool.space，无需 key。
# 原生币 USD 估值 / 盈亏估算使用 CoinGecko 公共接口，无需 key。

# ============ 运行参数 ============
# 新成交扫描间隔（秒），最小 20。钱包很多时可调大以省免费额度。
POLL_INTERVAL=60
# 红圈计数过滤：单笔成交金额 ≥ 此值(USD)才计入未读，避免小额刷屏
ALERT_MIN_USD=10000
# SQLite 数据库文件路径
DB_PATH=wallets.db

# ============ 运行开关 ============
# 是否启动 Telegram 机器人（仅查询命令，无推送）。只想用网页时设为 false。
# 注意：红圈未读提醒由网页服务负责，与此开关无关，设 false 也照常工作。
BOT_ENABLED=true

# ============ 网页面板 ============
WEB_ENABLED=true
# 默认只监听本机，安全。要外网访问改 0.0.0.0 并务必设置 WEB_TOKEN / 加反向代理
WEB_HOST=127.0.0.1
WEB_PORT=8000
# 网页访问令牌，留空=不校验（仅建议本机访问时留空）
WEB_TOKEN=
