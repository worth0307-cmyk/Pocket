# ============ Telegram ============
# 定向推送：只推「名称以 PUSH_PREFIX 开头」的钱包（见下），其余钱包只在面板亮红圈。
# 推送直接走 Bot HTTP API，不需要开机器人命令（BOT_ENABLED=false 也能推）。
# 两项都留空 = 完全不推送，只用面板红圈。
# 找 @BotFather 创建机器人拿到 token
TELEGRAM_BOT_TOKEN=
# 接收推送的聊天 ID（找 @userinfobot 获取你的数字 ID）
TELEGRAM_CHAT_ID=
# 允许控制机器人的 Chat ID 列表，逗号分隔；留空=默认用 TELEGRAM_CHAT_ID（仅你本人可用）
ALLOWED_CHAT_IDS=
# Telegram 代理（国内必填，api.telegram.org 被墙）。支持 http/socks5，例如：
#   http://127.0.0.1:7890   或   socks5://127.0.0.1:1080
# 留空=直连（仅在能直接访问 Telegram 的网络下可用）。
TELEGRAM_PROXY=

# ============ 数据源 API Key（免费，按需填）============
# EVM 链（ETH/BSC/Base/Arb/Polygon/OP）跟踪需要：https://etherscan.io/myapikey
# 一个 key 通吃所有 EVM 链（Etherscan V2）。不填则这些链不可用。
ETHERSCAN_API_KEY=
# Solana 动作解析需要：https://dashboard.helius.dev （免费档）
# 不填则 Solana 只能查余额、无法自动跟踪买卖。
HELIUS_API_KEY=
# 完整代币持仓 + USD 估值 + 多链聚合 + 垃圾币过滤（类 DeBank）需要：
# https://admin.moralis.com → 注册 → 复制 API Key（免费档 40K CU/月）
# 不填则 EVM 仅显示原生币余额（其余功能不受影响）。
# 只在你点开钱包看详情时按需调用，后台扫描不用它，因此不会烧光免费额度。
MORALIS_API_KEY=
# 比特币使用 mempool.space，无需 key。
# 原生币 USD 估值 / 盈亏估算使用 CoinGecko 公共接口，无需 key。

# ============ 运行参数 ============
# 新成交扫描间隔（秒），最小 20。扫描只查 Hyperliquid（免费无限额），不消耗 Moralis 额度。
POLL_INTERVAL=60
# 过滤：单笔成交金额 ≥ 此值(USD)才计入红圈/推送，避免小额刷屏
ALERT_MIN_USD=10000
# 单笔（或合并后）金额 ≥ 此值(USD)在推送里标「🔥」
ALERT_LARGE_USD=50000
# 只推送名称以此前缀开头的钱包（不区分大小写）。留空=全部钱包都推。
# 例：把自己的钱包在面板上改名成「ZR-主号」，就只会收到它的推送。
PUSH_PREFIX=ZR
# 合并窗口(秒)：同一钱包、同币种、同方向且间隔在此之内的连续成交合并成一条推送。
# HL 常把一笔大单拆成几十个成交，不合并会刷屏。设 0 = 不合并。
PUSH_MERGE_WINDOW=300
# SQLite 数据库文件路径
DB_PATH=wallets.db

# ============ 运行开关 ============
# 是否启动 Telegram 机器人（仅查询命令，无推送）。只想用网页时设为 false。
# 注意：红圈未读提醒由网页服务负责，与此开关无关，设 false 也照常工作。
BOT_ENABLED=true

# ============ 网页面板 ============
WEB_ENABLED=true
# 默认只监听本机，安全。要外网访问改 0.0.0.0 并务必设置 WEB_TOKEN / 加反向代理
WEB_HOST=127.0.0.1
WEB_PORT=8000
# 网页访问令牌，留空=不校验（仅建议本机访问时留空）
WEB_TOKEN=
